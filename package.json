{
  "name": "mvdis-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "監理站汽機車考照報名餘額監測",
  "scripts": {
    "sweep": "node --experimental-strip-types --no-warnings scripts/sweep.mjs",
    "stations:info": "node --experimental-strip-types --no-warnings scripts/stations-info.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --port 8788 --test-scheduled",
    "tick": "node scripts/tick.mjs",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute mvdis --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute mvdis --remote --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.151.1"
  }
}
