{
  "name": "mvdis-watch-replay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "監理服務網查詢端點的 Replay 模擬站（只給 VPC 內的實驗用）",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/replay.mjs",
    "dev": "npm run build && node dist/replay.mjs",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "fixtures:capture": "node --experimental-strip-types --no-warnings scripts/capture-fixtures.ts",
    "fixtures:dry-run": "node --experimental-strip-types --no-warnings scripts/capture-fixtures.ts --dry-run",
    "smoke": "node --experimental-strip-types --no-warnings scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.3"
  }
}
