# 複製成 .env 再改（.env 不要 commit）：cp .env.example .env && chmod 600 .env
# 一定要換掉密碼：sed -i "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(openssl rand -hex 24)/" .env
POSTGRES_PASSWORD=change-me

# api 綁在 127.0.0.1 的哪個 port（用 SSH tunnel 看：ssh -L 8200:127.0.0.1:8200 <主機>）
API_PORT=8200

# dispatcher 每分鐘送出的熱門／冷門組合數；合計不得超過 14（官網禮貌上限，契約 §3）
HOT_PER_TICK=11
COLD_PER_TICK=3

# 只能是 0 或 1，其他值（含空值）scheduler 會拒絕啟動。
# 0 = 完全不送 live 任務（不打官網）。先用 0 驗證流程，確認無誤再改成 1 開始抓官網。
DISPATCH_ENABLED=0

# live 任務的目標網址。預設直接連官網；主機連不到官網時（例如海外 VM 被擋），
# 改成 live-proxy/ 部署出來的轉發器網址，例如 https://mvdis-live-proxy.<子網域>.workers.dev
# MVDIS_LIVE_URL=https://www.mvdis.gov.tw

# S3 raw/ 與 events/ 保留天數（LocalStack 會把小物件放在記憶體）；0 = 不清
RAW_RETENTION_DAYS=3

WORKER_CONCURRENCY=5
