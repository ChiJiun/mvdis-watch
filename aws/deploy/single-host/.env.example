# 複製成 .env 再改（.env 不要 commit）：cp .env.example .env
# 產生密碼：openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# api 綁在 127.0.0.1 的哪個 port（用 SSH tunnel 看：ssh -L 8200:127.0.0.1:8200 <主機>）
API_PORT=8200

# dispatcher 每分鐘送出的熱門／冷門組合數；合計不得超過 14（官網禮貌上限，契約 §3）
HOT_PER_TICK=11
COLD_PER_TICK=3
# 設成 0 就完全不送 live 任務（不打官網），只跑 api、janitor；可以用實驗腳本另外灌 replay 任務
DISPATCH_ENABLED=1

# S3 raw/ 保留天數（LocalStack 會把小物件放在記憶體）；0 = 不清
RAW_RETENTION_DAYS=3

WORKER_CONCURRENCY=5
